OPENAI_API_KEY=NA
# ── SQLite (local fallback) ───────────────────────────────────────────────────
SQLITE_DB_PATH=data/ridebooking.db

# ── Snowflake (primary data warehouse) ───────────────────────────────────────
# Account identifier format: <account-locator>.<region>
# Derived from your URL: https://app.snowflake.com/ap-southeast-7.aws/ot93905/
SNOWFLAKE_ACCOUNT=ot93905.ap-southeast-7.aws
SNOWFLAKE_USER=your-snowflake-username
SNOWFLAKE_PASSWORD=NA
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_DATABASE=RIDEBOOKING_DB
SNOWFLAKE_SCHEMA=PUBLIC
SNOWFLAKE_TABLE=RIDEBOOKING

# Set to "snowflake" to use Snowflake, "sqlite" to use local SQLite
DATA_BACKEND=sqlite
